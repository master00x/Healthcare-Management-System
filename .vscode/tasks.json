
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Healthcare",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-g",
        "main.cpp",
        "Doctors/doctor.cpp",
        "Doctors/doctorStorage.cpp",
        "Doctors/doctorManager.cpp",
        "Appointment/AppointmentManager.cpp",
        "FileManagement/fileManager.cpp",
        "PrimaryIndex/PrimaryIndex.cpp",
        "SecondaryIndex/secondaryIndex.cpp",
        "SecondaryIndex/secondaryIndexManager.cpp",
        "QueryEngine/queryEngine.cpp",
        "-o",
        "Healthcare.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
